#: includes/class-abacatepay-wc-pix-blocks-integration.php:65
#: includes/class-abacatepay-wc-pix-gateway.php:81
msgid "Pix"
msgstr "Pix"

#: includes/class-abacatepay-wc-pix-gateway.php:51
msgid ""
"Accept Pix through AbacatePay. The QR code is shown right after checkout and "
"the order is confirmed automatically once paid."
msgstr "Receba via Pix com a AbacatePay. O QR Code aparece logo após a finalização da compra e o pedido é confirmado automaticamente após o pagamento."

#: includes/class-abacatepay-wc-pix-gateway.php:71
msgid "Enable/Disable"
msgstr "Ativar/Desativar"

#: includes/class-abacatepay-wc-pix-gateway.php:73
msgid "Enable Pix"
msgstr "Ativar Pix"

#: includes/class-abacatepay-wc-pix-gateway.php:77
msgid "Title"
msgstr "Título"

#: includes/class-abacatepay-wc-pix-gateway.php:79
msgid "Payment method name shown to the customer at checkout."
msgstr "Nome da forma de pagamento exibido ao cliente na finalização da compra."

#: includes/class-abacatepay-wc-pix-gateway.php:84
msgid "Description"
msgstr "Descrição"

#: includes/class-abacatepay-wc-pix-gateway.php:86
msgid "Text shown to the customer at checkout."
msgstr "Texto exibido ao cliente na finalização da compra."

#: includes/class-abacatepay-wc-pix-gateway.php:88
msgid ""
"Pay instantly with Pix. The QR code will be shown after you place the order."
msgstr "Pague na hora com Pix. O QR Code será exibido após você finalizar o pedido."

#: includes/class-abacatepay-wc-pix-gateway.php:91
msgid "AbacatePay integration"
msgstr "Integração com a AbacatePay"

#. translators: 1: list of permissions, 2: link to the documentation
#: includes/class-abacatepay-wc-pix-gateway.php:95
#, php-format
msgid ""
"Create an API key in the AbacatePay dashboard (Integration) with the %1$s "
"permissions. A Dev mode key creates test charges; a production key creates "
"real ones. %2$s"
msgstr "Crie uma chave de API no dashboard da AbacatePay (Integração) com as permissões %1$s. Uma chave de Dev mode gera cobranças de teste; uma chave de produção gera cobranças reais. %2$s"

#: includes/class-abacatepay-wc-pix-gateway.php:97
msgid "Learn more"
msgstr "Saiba mais"

#: includes/class-abacatepay-wc-pix-gateway.php:101
msgid "API key"
msgstr "Chave de API"

#: includes/class-abacatepay-wc-pix-gateway.php:106
msgid "Webhook"
msgstr "Webhook"

#. translators: 1: webhook URL, 2: list of events
#: includes/class-abacatepay-wc-pix-gateway.php:110
#, php-format
msgid ""
"In the AbacatePay dashboard, create a webhook with the URL %1$s, the secret "
"below and the events %2$s. Without it, orders are only confirmed when the "
"customer is on the order page or after the Pix expires."
msgstr "No dashboard da AbacatePay, crie um webhook com a URL %1$s, o secret abaixo e os eventos %2$s. Sem ele, os pedidos só são confirmados enquanto o cliente está na página do pedido ou depois que o Pix expira."

#: includes/class-abacatepay-wc-pix-gateway.php:116
msgid "Webhook secret"
msgstr "Secret do webhook"

#: includes/class-abacatepay-wc-pix-gateway.php:118
msgid ""
"Generated automatically. Use the same value when creating the webhook. "
"Webhooks with a different secret are rejected."
msgstr "Gerado automaticamente. Use o mesmo valor ao criar o webhook. Webhooks com outro secret são recusados."

#: includes/class-abacatepay-wc-pix-gateway.php:122
msgid "Payment"
msgstr "Pagamento"

#: includes/class-abacatepay-wc-pix-gateway.php:126
msgid "Pix expiration (minutes)"
msgstr "Validade do Pix (minutos)"

#: includes/class-abacatepay-wc-pix-gateway.php:128
msgid "How long the QR code can be paid. Use 0 for the AbacatePay default."
msgstr "Por quanto tempo o QR Code pode ser pago. Use 0 para o padrão da AbacatePay."

#: includes/class-abacatepay-wc-pix-gateway.php:136
msgid "Status while awaiting payment"
msgstr "Status enquanto aguarda o pagamento"

#: includes/class-abacatepay-wc-pix-gateway.php:139
msgid ""
"\"On hold\" reserves stock and emails the QR code to the customer. \"Pending "
"payment\" does neither."
msgstr "\"Aguardando\" reserva o estoque e envia o QR Code por e-mail ao cliente. \"Pagamento pendente\" não faz nenhum dos dois."

#: includes/class-abacatepay-wc-pix-gateway.php:142
msgctxt "Order status"
msgid "On hold"
msgstr "Aguardando"

#: includes/class-abacatepay-wc-pix-gateway.php:143
msgctxt "Order status"
msgid "Pending payment"
msgstr "Pagamento pendente"

#: includes/class-abacatepay-wc-pix-gateway.php:147
msgid "Status after payment"
msgstr "Status após o pagamento"

#: includes/class-abacatepay-wc-pix-gateway.php:154
msgid "Expired Pix"
msgstr "Pix expirado"

#: includes/class-abacatepay-wc-pix-gateway.php:156
msgid "Cancel the order (and restore stock) when the Pix expires unpaid"
msgstr "Cancelar o pedido (e devolver o estoque) quando o Pix expirar sem pagamento"

#: includes/class-abacatepay-wc-pix-gateway.php:160
msgid "Debug log"
msgstr "Log de depuração"

#: includes/class-abacatepay-wc-pix-gateway.php:162
msgid "Log API requests and responses"
msgstr "Registrar requisições e respostas da API"

#. translators: %s: link to the WooCommerce logs screen
#: includes/class-abacatepay-wc-pix-gateway.php:166
#, php-format
msgid ""
"Logs include customer data. Enable only while troubleshooting. View them in "
"%s."
msgstr "Os logs incluem dados dos clientes. Ative apenas para investigar problemas. Veja os registros em %s."

#: includes/class-abacatepay-wc-pix-gateway.php:167
msgid "WooCommerce > Status > Logs"
msgstr "WooCommerce > Status > Logs"

#: includes/class-abacatepay-wc-pix-gateway.php:180
msgid ""
"WooCommerce default (Processing, or Completed for virtual/downloadable "
"orders)"
msgstr "Padrão do WooCommerce (Processando, ou Concluído para pedidos virtuais/baixáveis)"

#: includes/class-abacatepay-wc-pix-gateway.php:204
msgid "Pix only works when the store currency is Brazilian real (BRL)."
msgstr "O Pix só funciona quando a moeda da loja é o real brasileiro (BRL)."

#: includes/class-abacatepay-wc-pix-gateway.php:210
msgid ""
"Pix is enabled but will not be offered at checkout until you set an API key."
msgstr "O Pix está ativado, mas só aparecerá na finalização da compra depois que você informar uma chave de API."

#: includes/class-abacatepay-wc-pix-gateway.php:263
msgid "AbacatePay Pix charge created. Awaiting payment."
msgstr "Cobrança Pix criada na AbacatePay. Aguardando pagamento."

#. translators: %s: error message returned by AbacatePay
#: includes/class-abacatepay-wc-pix-gateway.php:301
#, php-format
msgid "Could not create the Pix: %s"
msgstr "Não foi possível gerar o Pix: %s"

#: includes/class-abacatepay-wc-pix-gateway.php:304
msgid ""
"Pix is temporarily unavailable. Please try again or choose another payment "
"method."
msgstr "O Pix está temporariamente indisponível. Tente novamente ou escolha outra forma de pagamento."

#: includes/class-abacatepay-wc-pix-gateway.php:320
msgid "Pix payments must be at least R$ 1.00."
msgstr "O valor mínimo para pagamento via Pix é R$ 1,00."

#. translators: 1: store name, 2: order number
#: includes/class-abacatepay-wc-pix-gateway.php:332
#, php-format
msgid "%1$s - Order #%2$s"
msgstr "%1$s - Pedido #%2$s"

#: includes/class-abacatepay-wc-pix-gateway.php:361
msgid "Invalid response from AbacatePay."
msgstr "Resposta inválida da AbacatePay."

#: includes/class-abacatepay-wc-pix-gateway.php:500
msgid "Pix payment confirmed by AbacatePay."
msgstr "Pagamento via Pix confirmado pela AbacatePay."

#: includes/class-abacatepay-wc-pix-gateway.php:533
msgid "Pix expired without payment."
msgstr "O Pix expirou sem pagamento."

#: includes/class-abacatepay-wc-pix-gateway.php:548
#: includes/class-abacatepay-wc-pix-gateway.php:647
msgid "This order has no Pix charge."
msgstr "Este pedido não tem cobrança Pix."

#. translators: %s: amount paid
#: includes/class-abacatepay-wc-pix-gateway.php:655
#, php-format
msgid "AbacatePay only supports refunding the full amount paid (%s)."
msgstr "A AbacatePay só permite reembolsar o valor total pago (%s)."

#: includes/class-abacatepay-wc-pix-gateway.php:668
#: includes/class-abacatepay-wc-webhook.php:188
msgid "Pix refunded through AbacatePay."
msgstr "Pix reembolsado pela AbacatePay."

#: includes/class-abacatepay-wc-webhook.php:110
#: includes/class-abacatepay-wc-webhook.php:217
msgid "Dispute lost."
msgstr "Disputa perdida."

#. translators: 1: amount paid, 2: order total
#: includes/class-abacatepay-wc-webhook.php:142
#, php-format
msgid ""
"Pix of %1$s received, but the order total is %2$s. Check the payment before "
"shipping."
msgstr "Pix de %1$s recebido, mas o total do pedido é %2$s. Confira o pagamento antes de enviar."

#: includes/class-abacatepay-wc-webhook.php:176
msgid "Refunded through AbacatePay."
msgstr "Reembolsado pela AbacatePay."

#. translators: %s: dispute reason
#: includes/class-abacatepay-wc-webhook.php:205
#, php-format
msgid "Pix payment disputed by the payer: %s"
msgstr "Pagamento via Pix contestado pelo pagador: %s"

#: includes/class-abacatepay-wc-webhook.php:208
msgid "Pix dispute closed in favor of the store."
msgstr "Disputa do Pix encerrada a favor da loja."

#: includes/class-abacatepay-wc.php:132
msgid "Settings"
msgstr "Configurações"

#: includes/class-abacatepay-wc.php:143
msgid ""
"AbacatePay for WooCommerce requires WooCommerce to be installed and active."
msgstr "O AbacatePay for WooCommerce precisa do WooCommerce instalado e ativo."

